{
  "name": "clipvelto",
  "private": true,
  "workspaces": [
    "front-end",
    "back-end",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web,worker 'npm run dev --workspace @clipvelto/api' 'npm run dev --workspace @clipvelto/web' 'npm run dev:worker --workspace @clipvelto/api'",
    "dev:web": "npm run dev --workspace @clipvelto/web",
    "dev:setup": "npm run dev:setup --workspace @clipvelto/api",
    "dev:database": "npm run dev:database --workspace @clipvelto/api",
    "dev:uploads": "npm run dev:uploads --workspace @clipvelto/api",
    "transcriber:setup": "npm run transcriber:setup --workspace @clipvelto/api",
    "media:setup": "npm run media:setup --workspace @clipvelto/api",
    "media:check": "npm run media:check --workspace @clipvelto/api",
    "mail:check": "npm run mail:check --workspace @clipvelto/api",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently --kill-others --names api,web,worker 'npm run start --workspace @clipvelto/api' 'npm run start --workspace @clipvelto/web' 'npm run start:worker --workspace @clipvelto/api'",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @clipvelto/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run test:e2e --workspace @clipvelto/web --"
  },
  "overrides": {
    "mongodb": "~7.8.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "concurrently": "^10.0.7"
  }
}
