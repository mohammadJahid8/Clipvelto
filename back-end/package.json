{
  "name": "@clipvelto/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:setup": "tsx scripts/setup-development.ts",
    "dev:database": "tsx scripts/development-database.ts",
    "dev:uploads": "tsx scripts/development-uploads.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "transcriber:setup": "tsx scripts/setup-transcriber.ts",
    "start:worker": "node dist/worker.js",
    "mail:latest": "tsx scripts/latest-mail.ts",
    "mail:check": "tsx scripts/check-mail.ts",
    "paddle:setup": "tsx scripts/setup-paddle-sandbox.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "media:setup": "tsx scripts/setup-media.ts",
    "media:check": "tsx scripts/check-media.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:serve": "tsx scripts/test-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@better-auth/mongo-adapter": "1.7.25",
    "@clipvelto/credit-plans": "*",
    "@paddle/paddle-node-sdk": "^3.12.0",
    "better-auth": "1.7.25",
    "bullmq": "^6.7.6",
    "dotenv": "^18.0.10",
    "express": "5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mediainfo.js": "^0.3.9",
    "mongodb": "~7.8.0",
    "mongoose": "9.12.1",
    "nodemailer": "10.6.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@eslint/js": "^9.39.5",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/s3rver": "^3.7.4",
    "eslint": "^10.15.0",
    "mongodb-memory-server": "^11.3.0",
    "redis-memory-server": "^0.17.2",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
