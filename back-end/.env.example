NODE_ENV=development
PORT=4000
# Development-only simulated purchases use a separate test wallet.
# Use paddle for Paddle checkout, or disabled to prevent purchases.
BILLING_MODE=mock
# Paddle sandbox uses the test wallet. Keep secrets backend-only.
PADDLE_ENVIRONMENT=sandbox
PADDLE_LIVE_ENABLED=false
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# Current one-time USD pack prices before tax: Starter $6, Creator $15, Studio $32.
# Setup creates matching prices; keep original order snapshots for old payments.
# PADDLE_PRICE_STARTER=
# PADDLE_PRICE_CREATOR=
# PADDLE_PRICE_STUDIO=
# Run npm run paddle:setup --workspace @clipvelto/api -- --activate after saving
# a sandbox API key and configuring your default payment link in Paddle.
# Public webhook URL: https://your-domain/api/webhooks/paddle
# Sandbox can verify payments locally through the API; live requires webhooks.
MONGODB_URI=mongodb://127.0.0.1:27017/clipvelto?replicaSet=clipvelto
# Generate a unique secret with npm run dev:setup. Never use an example secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth Web application. Callback: http://localhost:3000/api/auth/callback/google
# Keep both values on the backend. Leave both blank to disable Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# File capture is local only; production requires SMTP and an HTTPS auth URL.
MAIL_TRANSPORT=file
# Contact form destination; defaults to the confirmed administrator account.
# CONTACT_TO_EMAIL=mohammadjahid0007@gmail.com
MAIL_FROM=Clipvelto <no-reply@clipvelto.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Resend uses the same SMTP transport; no additional email SDK is needed.
# After verifying clipvelto.com in Resend, use MAIL_TRANSPORT=smtp,
# SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, and your
# sending-only Resend API key as SMTP_PASSWORD. Keep MAIL_FROM on clipvelto.com.

# Local development upload services. Run npm run dev:uploads in a separate terminal.
UPLOADS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=clipvelto-local
STORAGE_ACCESS_KEY_ID=S3RVER
STORAGE_SECRET_ACCESS_KEY=S3RVER
STORAGE_FORCE_PATH_STYLE=true
# Production R2: HTTPS S3 endpoint, region auto, private bucket, scoped credentials.
# Authenticated source duration/storage is funded by credits, without plan caps.
# Active-stream capture remains a bounded 1–10 minute window.

# Select deepinfra or groq for hosted transcription, or local for CPU Whisper.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=local
# Set provider=groq and add a key to use hosted transcription. Never use NEXT_PUBLIC_.
# GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Set provider=deepinfra for DeepInfra. Keys stay backend-only.
# DEEPINFRA_API_KEY=
DEEPINFRA_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Local mode only; run npm run transcriber:setup before enabling it.
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_THREADS=2
TRANSCRIPTION_TIMEOUT_SECONDS=1800
# Optional absolute paths; defaults point inside back-end/.local-data/.
# TRANSCRIPTION_PYTHON=/absolute/path/to/venv/bin/python
# TRANSCRIPTION_MODEL_DIRECTORY=/absolute/path/to/model-cache

# YouTube imports and clip generation. Run npm run media:setup and media:check.
YOUTUBE_ENABLED=false
CLIPS_ENABLED=false
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# YOUTUBE_PYTHON=/absolute/path/to/media-venv/bin/python
# Optional private YouTube-only Netscape session file, chmod 600. Never commit it.
# Production mount: /run/clipvelto-youtube/cookies.txt (see README).
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Keep public previews disabled until real Turnstile keys are configured.
# Use separate widgets for localhost and production. API verifies hostname/action.
TRIAL_ENABLED=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Global public-trial budget: up to 10 three-minute submissions per UTC day.
TRIAL_DAILY_MINUTES=30
# Localhost development only: repeat trials without the network/daily budget limits.
# Ignored in production and when BETTER_AUTH_URL is not localhost/loopback.
TRIAL_LOCAL_TESTING=false
